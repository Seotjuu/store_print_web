# 네이버 커머스 API (https://apicenter.commerce.naver.com 애플리케이션 등록 정보)
# 주의: CLIENT_SECRET 값에 포함된 $ 문자는 Next.js 환경변수 치환(dotenv-expand) 때문에
#       반드시 \$ 로 escape 해서 넣어야 한다. 예: $2a$04$xxxx -> \$2a\$04\$xxxx
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 위탁판매 등으로 대표 계정이 아닌 하위 계정을 사용할 때만 채움 (일반 셀러는 비워둠)
NAVER_ACCOUNT_ID=

# 운송장에 인쇄될 보내는 사람(발송지) 정보
SENDER_NAME=
SENDER_PHONE=
SENDER_ADDRESS=
SENDER_ADDRESS_DETAIL=
